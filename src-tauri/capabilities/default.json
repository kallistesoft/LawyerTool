{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: our own commands and event listening only. No fs, shell or http plugins.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-app-info",
    "allow-vault-status",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-recover",
    "allow-vault-lock",
    "allow-activity",
    "allow-update-check",
    "allow-update-install",
    "allow-client-list",
    "allow-client-overview",
    "allow-client-get",
    "allow-client-save",
    "allow-client-delete",
    "allow-assess",
    "allow-deid-preview",
    "allow-export-report",
    "allow-settings-get",
    "allow-settings-pick",
    "allow-settings-clear",
    "allow-inbox-list",
    "allow-inbox-import",
    "allow-watch-status",
    "allow-watch-check-now",
    "allow-watch-approve",
    "allow-watch-reject",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
